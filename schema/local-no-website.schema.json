{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VDS Local SME Website-Gap Prospect",
  "type": "object",
  "required": ["id","business","country","location","activity_type","identity_verified","website_status","website_gap_score","contact","tax_marketing","offer","evidence","personalized_angle","status","first_contact_state","timeline","last_verified_at"],
  "properties": {
    "id": {"type":"string"},
    "business": {"type":"string"},
    "country": {"type":"string"},
    "location": {
      "type":"object",
      "required":["country","region","province","municipality"],
      "properties": {
        "country":{"type":"string"},
        "region":{"type":["string","null"]},
        "province":{"type":["string","null"]},
        "district_or_comarca":{"type":["string","null"]},
        "municipality":{"type":"string"},
        "neighborhood":{"type":["string","null"]},
        "postal_code":{"type":["string","null"]},
        "address":{"type":["string","null"]}
      }
    },
    "activity_type":{"type":"string"},
    "activity_subtype":{"type":["string","null"]},
    "identity_verified":{"type":"boolean"},
    "website_status":{"enum":["NO_DEDICATED_WEBSITE_VERIFIED","BROKEN_OR_NONFUNCTIONAL","AMBIGUOUS_REVERIFY","HAS_WEBSITE_REJECT"]},
    "online_presence":{"type":"object"},
    "reputation":{"type":"object","properties":{"rating":{"type":["number","null"]},"review_count":{"type":["integer","null"]},"source":{"type":["string","null"]}}},
    "website_gap_score":{"type":"object","required":["score","components"],"properties":{"score":{"type":"integer","minimum":0,"maximum":100},"components":{"type":"object","properties":{"website_absence":{"type":"integer","minimum":0,"maximum":25},"business_quality":{"type":"integer","minimum":0,"maximum":20},"commercial_upside":{"type":"integer","minimum":0,"maximum":20},"competitor_gap":{"type":"integer","minimum":0,"maximum":15},"contactability":{"type":"integer","minimum":0,"maximum":10},"personalization_strength":{"type":"integer","minimum":0,"maximum":10}}}}},
    "contact":{"type":"object","properties":{"emails":{"type":"array","items":{"type":"string"}},"phones":{"type":"array","items":{"type":"string"}},"whatsapp":{"type":"array","items":{"type":"string"}},"public_contact_pages":{"type":"array","items":{"type":"string"}}}},
    "tax_marketing":{"type":"object","required":["country_policy_status","claim_mode"],"properties":{"country_policy_status":{"enum":["VERIFIED_OFFICIAL_SOURCE","PARTIAL_REVIEW","NOT_VERIFIED"]},"claim_mode":{"enum":["CONDITIONAL_BUSINESS_EXPENSE","NO_TAX_CLAIM"]},"summary":{"type":"string"},"official_sources":{"type":"array","items":{"type":"string"}},"mandatory_disclaimer":{"type":"string"}}},
    "offer":{"type":"object","properties":{"code":{"type":"string"},"price_eur":{"type":"number"},"positioning":{"type":"string"}}},
    "evidence":{"type":"array","items":{"type":"object"}},
    "personalized_angle":{"type":"string"},
    "quality_rejection_reason":{"type":["string","null"]},
    "status":{"enum":["RAW_DISCOVERY","RESEARCH","QUALIFIED","READY_FOR_CONTACT_REVIEW","DRAFT_APPROVAL_REQUIRED","READY_TO_CONTACT","CONTACTED","REPLIED","LOST","WON","REJECTED"]},
    "first_contact_state":{"enum":["NEVER_SENT","SENT","SUPPRESSED"]},
    "suppression_checked":{"type":"boolean"},
    "timeline":{"type":"array","items":{"type":"object"}},
    "last_verified_at":{"type":"string"}
  }
}