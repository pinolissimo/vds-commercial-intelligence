{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "VDS Commercial Company — CRM v2/v3 compatible",
  "type": "object",
  "required": ["schema_version", "id", "company", "country", "location", "category", "priority", "scores", "contacts", "evidence", "freshness", "economics", "opportunities", "campaign_ids", "status", "timeline", "next_action", "last_verified_at"],
  "properties": {
    "schema_version": {"enum": ["2.0", "3.0"]},
    "id": {"type": "string"},
    "company": {"type": "string"},
    "website": {"type": ["string", "null"]},
    "country": {"enum": ["Italy", "Spain", "Other"]},
    "location": {"type":"object","required":["region","city","address"],"properties":{"region":{"type":"string"},"city":{"type":"string"},"address":{"type":["string","null"]}}},
    "category": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "priority": {"enum":["HOT","HIGH","MEDIUM","WATCH"]},
    "scores": {"type":"object","required":["opportunity_score","outsourcing_score","vds_fit_score","revenue_potential_score","revenue_priority_score"],"properties":{"opportunity_score":{"type":"integer","minimum":0,"maximum":100},"outsourcing_score":{"type":"integer","minimum":0,"maximum":100},"vds_fit_score":{"type":"integer","minimum":0,"maximum":100},"revenue_potential_score":{"type":"integer","minimum":0,"maximum":100},"revenue_priority_score":{"type":"integer","minimum":0,"maximum":100}}},
    "lead_health": {"type":"object","properties":{"score":{"type":"integer","minimum":0,"maximum":100},"class":{"enum":["CRITICAL","HOT","WARM","COOL","DORMANT"]},"calculated_at":{"type":"string"},"components":{"type":"object"},"penalties":{"type":"array","items":{"type":"string"}}}},
    "account_intelligence": {"type":"object","properties":{"company_type":{"type":["string","null"]},"engagement_model":{"type":["string","null"]},"decision_makers":{"type":"array","items":{"type":"object"}},"relationship_strength":{"enum":["NONE","COLD","WARM","ACTIVE","STRATEGIC"]}}},
    "contact_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "primary_contact_id": {"type":["string","null"]},
    "contacts": {"type":"object","required":["emails","phones","people","application_url"],"properties":{"emails":{"type":"array","items":{"type":"string"}},"phones":{"type":"array","items":{"type":"string"}},"people":{"type":"array","items":{"type":"object"}},"application_url":{"type":["string","null"]}}},
    "fit_reason": {"type":"array","items":{"type":"string"}},
    "evidence": {"type":"array","items":{"type":"object","required":["url","verified_at","note"],"properties":{"url":{"type":"string"},"verified_at":{"type":"string"},"published_at":{"type":["string","null"]},"expires_at":{"type":["string","null"]},"note":{"type":"string"}}}},
    "freshness": {"type":"object","required":["first_seen_at","last_verified_at","freshness_score","source_status"],"properties":{"first_seen_at":{"type":"string"},"last_verified_at":{"type":"string"},"opportunity_published_at":{"type":["string","null"]},"expires_at":{"type":["string","null"]},"freshness_score":{"type":"integer","minimum":0,"maximum":100},"source_status":{"enum":["CURRENT","EVERGREEN","STALE","EXPIRED","TO_VERIFY"]}}},
    "economics": {"type":"object","required":["currency","estimated_value_low","estimated_value_high","probability_pct","weighted_value","recurring_potential","estimate_confidence"],"properties":{"currency":{"const":"EUR"},"estimated_value_low":{"type":["number","null"],"minimum":0},"estimated_value_high":{"type":["number","null"],"minimum":0},"probability_pct":{"type":["number","null"],"minimum":0,"maximum":100},"weighted_value":{"type":["number","null"],"minimum":0},"recurring_potential":{"enum":["UNKNOWN","LOW","MEDIUM","HIGH"]},"estimate_confidence":{"enum":["NONE","LOW","MEDIUM","HIGH"]},"notes":{"type":["string","null"]}}},
    "suppression_state": {"enum":["CLEAR","FIRST_CONTACT_ALREADY_SENT","DO_NOT_CONTACT","UNSUBSCRIBED","HARD_BOUNCE","INVALID_CONTACT","EXISTING_CLIENT","MANUAL_SUPPRESSION"]},
    "opportunities": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "campaign_ids": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "attribution": {"type":"object","properties":{"first_source":{"type":["string","null"]},"latest_source":{"type":["string","null"]},"acquisition_segment":{"type":["string","null"]},"language":{"type":["string","null"]},"positioning":{"type":["string","null"]}}},
    "status": {"enum":["RESEARCH","QUALIFIED","READY_TO_CONTACT","CONTACTED","FOLLOW_UP_DUE","FOLLOW_UP_SENT","NEGATIVE_AUTO_REPLIED","NURTURE","FUTURE_OPPORTUNITY","LOST","REVIEW_REQUIRED","POSITIVE_REPLY_USER_ACTION_REQUIRED","MEETING","PROPOSAL","WON","LOST_AFTER_PROPOSAL","MONITOR"]},
    "outreach": {"type":"array","items":{"type":"object"}},
    "timeline": {"type":"array","items":{"$ref":"event.schema.json"}},
    "next_action": {"type":"object","required":["action","due_at","owner","priority"],"properties":{"action":{"type":"string"},"reason":{"type":"string"},"due_at":{"type":["string","null"]},"owner":{"enum":["AUTOMATION","USER","NONE"]},"priority":{"enum":["CRITICAL","HIGH","NORMAL","LOW","NONE"]},"expected_commercial_impact":{"enum":["VERY_HIGH","HIGH","MEDIUM","LOW","NONE"]},"confidence":{"enum":["HIGH","MEDIUM","LOW"]}}},
    "notes": {"type":"array","items":{"type":"string"}},
    "last_verified_at": {"type":"string"}
  }
}